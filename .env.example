# Local development only. Replace these values for any deployed environment.
DATABASE_URL=postgresql+psycopg://career_copilot:local-development-only@localhost:5432/career_copilot
# Tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://career_copilot:local-development-only@localhost:55433/career_copilot_test
# Required at application startup. Generate your own secret from backend/:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the generated value only in the ignored .env file or deployment secret store.
JWT_SECRET=
# Optional; default 1800 seconds (30 minutes), supported range 1-3600.
JWT_SESSION_TTL_SECONDS=1800
